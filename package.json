{
  "name": "arrs-hub",
  "private": true,
  "version": "1.3.16",
  "description": "Arrs Hub — dashboard and watchdog for your Plex / *arr stack",
  "author": "machineshop44",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm run server\" \"npm run web\"",
    "web": "vite",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "build:win": "npm run dist:win",
    "pack:win": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "chromecast-api": "^0.4.2",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "electron@37.10.3": true
  },
  "build": {
    "appId": "com.machineshop44.arrs-hub",
    "productName": "Arrs Hub",
    "copyright": "Copyright © machineshop44",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json",
      "!mobile/**/*",
      "!src/**/*",
      "!data/**/*",
      "!release/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "dist/**/*",
      "package.json",
      "**/node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arrs Hub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
